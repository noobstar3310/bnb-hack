# Binance Web3 API credentials — https://web3.binance.com/en/dev-portal/project
# Copy to .env.local (git-ignored) and fill in. Server-side only: do NOT add a
# NEXT_PUBLIC_ prefix, which would expose the secret in the browser bundle.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Price signer for /api/prices (EIP-712). Server-side only. Its address must match
# AssetRegistry.priceSigner(). For local dev generate a throwaway key; never commit a real one.
PRICE_SIGNER_PRIVATE_KEY=

# Chain the API reads. Local dev: http://127.0.0.1:8545 (anvil, see scripts/dev-chain.sh).
CHAIN_RPC_URL=
# Optional: override the factory address from lib/contracts/addresses.ts.
# FACTORY_ADDRESS=
# Optional: refuse prices more than this many bps from the reference price (default 200).
# PRICE_MAX_DIVERGENCE_BPS=200
# Dev only: comma-separated vaults outside the factory to list (printed by scripts/dev-chain.sh).
# DEV_EXTRA_VAULTS=
