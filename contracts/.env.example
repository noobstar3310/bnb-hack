# Copy to .env (git-ignored). Never commit real keys.

# BSC endpoints. Public dataseed works for reads; use a private RPC for deploys.
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Etherscan V2 key — one key covers BSC mainnet (56) and testnet (97).
ETHERSCAN_API_KEY=

# Deploys are signed from an encrypted keystore, not from a raw key here:
#   cast wallet import deployer --interactive
#   forge script ... --account deployer
